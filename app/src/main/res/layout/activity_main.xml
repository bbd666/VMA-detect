<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btn_load_csv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Charger un fichier .csv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="60dp"/>

    <LinearLayout
        android:id="@+id/layout_threshold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_load_csv">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seuil de détection (m) : "
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_threshold"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="5"
            android:textAlignment="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Vitesse : 0 km/h"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_threshold" />

    <TextView
        android:id="@+id/tv_speed_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Limite : -- km/h"
        android:textSize="24sp"
        android:textColor="#555555"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_speed" />

    <TextView
        android:id="@+id/tv_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Recherche du signal GPS..."
        android:textSize="14sp"
        android:textStyle="normal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_speed_limit" />

    <TextView
        android:id="@+id/tv_nearest_panneau"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Panneau le plus proche : --"
        android:textSize="18sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_location" />

    <LinearLayout
        android:id="@+id/layout_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_nearest_panneau">

        <Button
            android:id="@+id/btn_toggle_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Activer Log GPS" />

        <Button
            android:id="@+id/btn_test_simu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Simulation" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_zone30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_controls">

        <Button
            android:id="@+id/btn_zone30"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/round_button"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/btn_zone30"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_fin_zone30"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/round_button_gray"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/btn_fin_zone30"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_agglo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_zone30">

        <Button
            android:id="@+id/btn_agglo_entree"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/round_button"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/btn_agglo_entree"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_agglo_sortie"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/round_button_gray"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/btn_agglo_sortie"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_limits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_agglo">

        <Button
            android:id="@+id/btn_limit_30"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/round_button_white_red"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/limit_30"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_limit_50"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/round_button_white_red"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/limit_50"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_limit_70"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/round_button_white_red"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/limit_70"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_limit_fin"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:background="@drawable/round_button_white_black"
            android:foreground="@drawable/foreground_diagonal_bar"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/limit_fin"
            android:textColor="#000000"
            android:textSize="14sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_csv_filename"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="Fichier : aucun"
        android:textSize="14sp"
        android:textColor="#888888"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>